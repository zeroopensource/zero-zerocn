{
  "name": "@zeroopensource/zero-zerocn",
  "version": "0.0.1",
  "private": true,
  "description": "Shadcn registry made by Zero",
  "homepage": "https://zerocn.zeroopensource.org",
  "repository": "https://github.com/zeroopensource/zero-zerocn",
  "scripts": {
    "build": "pnpm copy-readme && pnpm build:registry && next build && pnpm fix:next-out",
    "build:registry": "pnpm shadcn:addAllItem && shadcn build",
    "copy-readme": "tsx scripts/copy-readme.ts",
    "dev": "pnpm build && pnpm dev:next",
    "dev:next": "dotenv -e .env -- next dev",
    "fix:next-out": "tsx scripts/fix-next-out.ts",
    "postinstall": "fumadocs-mdx",
    "next": "next",
    "serve": "pnpm build && serve out",
    "shadcn": "shadcn",
    "shadcn:addAllItem": "tsx scripts/generate-registry-all-item",
    "shadcn:zero": "pnpm shadcn add https://zerocn.zeroopensource.org/r/all.json -y -o",
    "start": "dotenv -e .env -- next start",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "zero": "zero"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@giscus/react": "^3.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@hugeicons/react": "^1.1.1",
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-email/components": "1.0.8",
    "@shadcn/react": "^0.3.1",
    "@swc/helpers": "^0.5.23",
    "@t3-oss/env-core": "0.13.10",
    "@t3-oss/env-nextjs": "0.13.10",
    "@tanstack/react-form": "1.28.3",
    "@tanstack/react-table": "^8.21.3",
    "@zxcvbn-ts/core": "^3.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3",
    "drizzle-kit": "^0.31.8",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "16.15.12",
    "fumadocs-mdx": "15.4.3",
    "fumadocs-ui": "16.15.12",
    "html-react-parser": "5.2.17",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "nanoid": "5.1.6",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "8.0.1",
    "nuqs": "^2.8.5",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.68.0",
    "react-resizable-panels": "^4.13.1",
    "recharts": "3.8.0",
    "serve": "^14.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/fs-extra": "^11.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/nodemailer": "7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@zeroopensource/zero-cli": "latest",
    "@zeroopensource/zero-id": "latest",
    "dotenv-cli": "11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fs-extra": "^11.4.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "shortName": "ZeroCN"
}
